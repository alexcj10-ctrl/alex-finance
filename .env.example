# Valori pubblici del client browser. Lasciare vuoti finché il progetto Supabase non esiste.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo server/Vercel Functions. Non usare mai il prefisso VITE_ per questi segreti.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Solo server. Segreto stabile e indipendente dalla chiave Supabase (minimo 32 byte).
# Non ruotare senza una migrazione esplicita delle credenziali Player.
PLAYER_CREDENTIAL_PEPPER=

# Solo server. UUID obbligatorio della squadra autorizzata alla registrazione.
PLAYER_SIGNUP_TEAM_ID=
